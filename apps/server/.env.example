# Azure OpenAI Configuration
AZURE_OPENAI_API_KEY=your_azure_openai_api_key
AZURE_OPENAI_API_ENDPOINT=your_endpoint_name
AZURE_OPENAI_API_DEPLOYMENT_NAME=your_deployment_name
AZURE_OPENAI_API_VERSION=2024-08-01-preview

# tavily Configuration
TAVILY_API_KEY=your_tavily_api_key

# Tavily Extract tuning
# Options: basic | advanced
SEDIMENT_TAVILY_EXTRACT_DEPTH=basic
# Options: text | markdown
SEDIMENT_TAVILY_EXTRACT_FORMAT=markdown

# RapidAPI Configuration (for YouTube transcripts)
RAPIDAPI_KEY=your_rapidapi_key
