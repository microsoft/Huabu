# Server-private secrets. Shared dev parameters (ports, proxy target) live in
# the repo-root `.env` instead — see `<repo-root>/.env.example`.

# ── LLM Provider Configuration ──
# Set API key for your chosen provider. Only one provider is needed.
# The active provider/model can also be changed at runtime via the Settings UI.

# Anthropic
# ANTHROPIC_API_KEY=sk-ant-...

# OpenAI
# OPENAI_API_KEY=sk-...

# Azure OpenAI (legacy default — still supported)
AZURE_OPENAI_API_KEY=your_azure_openai_api_key
AZURE_OPENAI_API_ENDPOINT=your_endpoint_name
AZURE_OPENAI_API_DEPLOYMENT_NAME=your_deployment_name
AZURE_OPENAI_API_VERSION=2024-08-01-preview

# Google Gemini
# GEMINI_API_KEY=...

# OpenRouter (access many models with one key)
# OPENROUTER_API_KEY=sk-or-...

# Groq
# GROQ_API_KEY=gsk_...

# xAI
# XAI_API_KEY=xai-...

# Mistral
# MISTRAL_API_KEY=...

# tavily Configuration
TAVILY_API_KEY=your_tavily_api_key

# Tavily Extract tuning
# Options: basic | advanced
SEDIMENT_TAVILY_EXTRACT_DEPTH=basic
# Options: text | markdown
SEDIMENT_TAVILY_EXTRACT_FORMAT=markdown

# RapidAPI Configuration (for YouTube transcripts)
RAPIDAPI_KEY=your_rapidapi_key

# HTTP Proxy
# HTTPS_PROXY=http://127.0.0.1:1086

# ── Workspace storage ──
# When set, the server runs in "managed" mode: the workspace path is
# locked to this absolute path at startup and cannot be changed at
# runtime. The client gets a read-only label (the basename) and no
# folder-picker UI. To run a different workspace, restart the process
# with a different value — typically one process per workspace, with
# network access controlled by your reverse proxy.
#
# When unset, the server runs in "free" mode: clients pick any absolute
# directory via folder picker / path input (suitable for local dev).
# SEDIMENT_WORKSPACE=/var/lib/sediment/team-a
