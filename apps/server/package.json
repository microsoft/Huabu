{
  "name": "@huabu/server",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "lint": "eslint .",
    "format": "prettier --write .",
    "build": "tsc -p tsconfig.json",
    "prebundle": "node -e \"require('node:fs').rmSync('dist-bundle', { recursive: true, force: true })\"",
    "bundle": "tsup",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "start": "tsx src/server.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "dump:prompts": "tsx scripts/dump-prompts.ts",
    "eval": "tsx evals/cli.ts run",
    "eval:list": "tsx evals/cli.ts list",
    "eval:baseline": "tsx evals/cli.ts baseline",
    "eval:diff": "tsx evals/cli.ts diff"
  },
  "dependencies": {
    "@agenetes/acp-driver": "workspace:*",
    "@agenetes/agent-team": "workspace:*",
    "@agenetes/agenetes": "workspace:*",
    "@agenetes/agentlet-host": "workspace:*",
    "@agenetes/pi-driver": "workspace:*",
    "@agenetes/protocol": "workspace:*",
    "@agenetes/runtime": "workspace:*",
    "@agentclientprotocol/sdk": "^0.22.1",
    "@agentlet/protocol": "workspace:*",
    "@earendil-works/pi-agent-core": "^0.81.1",
    "@earendil-works/pi-ai": "^0.81.1",
    "@fastify/compress": "^8.3.1",
    "@fastify/cors": "^10.0.1",
    "@fastify/multipart": "^9.0.1",
    "@fastify/static": "^8.0.2",
    "@mozilla/readability": "^0.6.0",
    "@opendocsg/pdf2md": "^0.2.5",
    "@resvg/resvg-wasm": "^2.6.2",
    "@huabu/shared": "workspace:*",
    "archiver": "^7.0.1",
    "dotenv": "^17.2.3",
    "fastify": "^5.2.0",
    "image-size": "^2.0.2",
    "linkedom": "^0.18.12",
    "marked": "^16.3.0",
    "officeparser": "^7.2.1",
    "openai": "^6.44.0",
    "perfect-freehand": "0.3.5",
    "pino": "^10.3.1",
    "sanitize-html": "^2.17.0",
    "turndown": "^7.2.4",
    "undici": "^7.24.5",
    "yaml": "^2.8.4",
    "yauzl": "^3.3.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/archiver": "^7.0.0",
    "@types/node": "^22.15.0",
    "@types/sanitize-html": "^2.16.0",
    "@types/turndown": "^5.0.6",
    "@types/yauzl": "^2.10.3",
    "tsup": "^8.5.1",
    "tsx": "^4.0.0",
    "typescript": "^6.0.3",
    "vite": "^7.0.0",
    "vitest": "^4.0.18"
  }
}
