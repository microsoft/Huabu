{
  "name": "@huabu/desktop",
  "version": "0.9.2",
  "private": true,
  "description": "Huabu desktop application (Electron wrapper)",
  "author": "Huabu Team",
  "main": "dist/main.js",
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/build-splash.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run src",
    "icons:build": "node scripts/build-icons.mjs",
    "dist": "pnpm run build && electron-builder --publish never",
    "dist:mac": "pnpm run build && electron-builder --mac --publish never",
    "dist:win": "pnpm run build && electron-builder --win --publish never",
    "dist:linux": "pnpm run build && electron-builder --linux --publish never",
    "dev": "pnpm run build && node scripts/dev.mjs"
  },
  "dependencies": {
    "electron-updater": "^6.3.9",
    "get-port": "^7.1.0"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "electron": "43.1.1",
    "electron-builder": "^26.0.0",
    "lottie-web": "^5.13.0",
    "png2icons": "^2.0.1",
    "sharp": "^0.34.5",
    "typescript": "^6.0.3",
    "vitest": "^4.0.18"
  }
}
