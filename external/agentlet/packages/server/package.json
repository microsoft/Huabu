{
  "name": "@agentlet/server",
  "version": "0.1.0",
  "description": "Relay server for accepting and managing agent-side adapter connections over WebSocket",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "agentlet-server": "./dist/standalone.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "clean": "rm -rf dist",
    "lint": "tsc --noEmit"
  },
  "dependencies": {
    "@agentlet/protocol": "workspace:*",
    "sql.js": "^1.14.1",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/sql.js": "^1.4.11",
    "@types/ws": "^8.5.0",
    "typescript": "^5.9.0"
  }
}
