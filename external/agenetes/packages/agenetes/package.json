{
  "name": "@agenetes/agenetes",
  "version": "0.1.0",
  "description": "The mounted Agenetes instance: static driver dispatch, live AgentHandle lifecycle, and durable thread records.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "clean": "rm -rf dist",
    "lint": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@agenetes/protocol": "workspace:*",
    "@agenetes/runtime": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "typescript": "^5.9.0",
    "vitest": "^4.0.18"
  }
}
