#!/usr/bin/env sh
# Stable short entry point for the vendored agentlet CLI.
#
# Goal: zero shell-config burden on users. They should only need to:
#   1. Put `ACP_DEV_TOKEN=...` in <repo>/.env  (once)
#   2. Run `<repo>/bin/agentlet --agent "<cmd>"`        (every time)
#
# This wrapper takes care of everything else by reading <repo>/.env itself,
# auto-building the CLI on first run, deriving the right defaults, and
# forwarding any extra flags to the underlying agentlet CLI verbatim.
# Nothing needs to live in ~/.bashrc.

here=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
repo=$(CDPATH= cd -- "$here/.." && pwd)
cli="$repo/external/agentlet/packages/local/dist/index.js"

# Auto-build on first run (or after a clean) so users never have to
# remember `pnpm run build:agentlet` separately. We only build if the
# compiled entry is missing — if it exists but is stale, the user is
# expected to rebuild (or `pnpm dev` will, via its `predev` hook).
if [ ! -f "$cli" ]; then
  echo "agentlet wrapper: $cli not found — building..." >&2
  if ! (cd "$repo" && pnpm run build:agentlet >&2); then
    echo "agentlet wrapper: build failed. Run \`pnpm run build:agentlet\` in $repo manually." >&2
    exit 1
  fi
  if [ ! -f "$cli" ]; then
    echo "agentlet wrapper: build completed but $cli still missing." >&2
    exit 1
  fi
fi

# Auto-load <repo>/.env so the same token the server already reads via
# dotenv (ACP_DEV_TOKEN) becomes available here too. We strip
# CR before sourcing because the file may have CRLF line endings (some
# editors do that), which POSIX `.` interprets as part of the value and
# trips with `: not found` errors. `set -a` makes every assignment in
# .env exported, not just shell-local.
if [ -f "$repo/.env" ]; then
  envtmp=$(mktemp 2>/dev/null || echo "/tmp/agentlet-env.$$")
  trap 'rm -f "$envtmp"' EXIT INT TERM
  tr -d '\r' < "$repo/.env" > "$envtmp"
  set -a
  # shellcheck disable=SC1090
  . "$envtmp"
  set +a
  rm -f "$envtmp"
  trap - EXIT INT TERM
fi

# agentlet CLI expects AGENTLET_TOKEN — derive it from the canonical
# server-side name if the user didn't set it explicitly. Single source
# of truth: ACP_DEV_TOKEN in <repo>/.env.
: "${AGENTLET_TOKEN:=$ACP_DEV_TOKEN}"
export AGENTLET_TOKEN

# Server URL.
#   - Default = ws://localhost:${SERVER_PORT:-3001}/api/acp/agent, i.e. the
#     embedded mount that `pnpm dev` exposes on the same port as the rest of
#     Sediment's API. SERVER_PORT already lives in .env (see .env.example)
#     and the server reads it from there too — single source of truth.
#   - For non-local setups (different host, wss://, custom path) set
#     ACP_URL to the full URL — it wins outright.
if [ -n "$ACP_URL" ]; then
  url="$ACP_URL"
else
  url="ws://localhost:${SERVER_PORT:-3001}/api/acp/agent"
fi

# `--allow-insecure` is required by agentlet for ws:// (non-TLS) URLs but
# disallowed for wss://. Auto-pick based on the URL scheme so users never
# have to think about it.
insecure_flag=
case "$url" in
  ws://*) insecure_flag=--allow-insecure ;;
esac

# Pre-flight: if the user told us which agent CLI to launch (e.g.
# `--agent "copilot --acp --allow-all"`), make sure that CLI is actually
# on PATH. Otherwise the failure mode is a confusing ACP handshake error
# rather than "the binary doesn't exist", which sends people down the
# wrong debugging path. We only check, never auto-install.
agent_cmd=
prev=
for arg in "$@"; do
  case "$prev" in
    --agent) agent_cmd="$arg"; break ;;
  esac
  case "$arg" in
    --agent=*) agent_cmd="${arg#--agent=}"; break ;;
  esac
  prev="$arg"
done

if [ -n "$agent_cmd" ]; then
  # First whitespace-separated token of the --agent value is the
  # executable; everything after it is forwarded as flags to that CLI.
  # POSIX word-splitting via positional params, in a subshell so we
  # don't clobber the outer "$@".
  agent_bin=$(set -f; set -- $agent_cmd; printf '%s\n' "$1")
  # Skip the check if the user supplied an explicit path — `command -v`
  # would still work, but a path-based agent is an unusual case and we'd
  # rather not second-guess it.
  case "$agent_bin" in
    */*|'') ;;
    *)
      if ! command -v "$agent_bin" >/dev/null 2>&1; then
        echo "agentlet wrapper: \"$agent_bin\" was not found on PATH." >&2
        echo "  Install the CLI first, e.g.:" >&2
        case "$agent_bin" in
          copilot) echo "    npm install -g @github/copilot" >&2 ;;
          claude)  echo "    npm install -g @anthropic-ai/claude-code" >&2 ;;
          gemini)  echo "    npm install -g @google/gemini-cli" >&2 ;;
          *)       echo "    (see the agent's own install instructions)" >&2 ;;
        esac
        exit 127
      fi
      ;;
  esac
fi

exec node "$cli" --server "$url" $insecure_flag "$@"
