# Run pre/post hooks for arbitrary scripts (pnpm disables this by default
# since v7). Required for the `predev` / `predev:desktop` hooks in the root
# package.json to rebuild the agentlet workspace packages before starting
# the dev orchestrator — otherwise `external/agentlet/packages/*/dist/`
# can fall out of sync with `src/` after switching branches, leaving the
# daemon or Gateway consumers on stale protocol declarations.
enable-pre-post-scripts=true

# Pin the pnpm virtual store to THIS workspace's node_modules. Without an
# explicit value pnpm can re-derive / inherit a virtual store path from a
# sibling git worktree (e.g. ../Sediment.worktrees/*), which silently relinks
# packages like `vite` to a different version present in that foreign store
# and breaks the local dev/test toolchain. The relative path always resolves
# against this workspace root, so it is correct on every machine and worktree.
virtual-store-dir=node_modules/.pnpm

# apps/web is on React 18 and apps/docs is on React 19. pnpm hoists one
# arbitrary version of each package into the hidden `node_modules/.pnpm/
# node_modules/` directory, and TypeScript resolves untyped `react` imports
# from a dependency's own location upwards — so a hoisted `@types/react@18`
# leaks into `react-router`'s React 19 declarations and produces bogus
# `ReactNode` mismatches. Keep both packages out of the hidden hoist so each
# app only ever sees the React types it declares.
hoist-pattern[]=*
hoist-pattern[]=!@types/react
hoist-pattern[]=!@types/react-dom
