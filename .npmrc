# Run pre/post hooks for arbitrary scripts (pnpm disables this by default
# since v7). Required for the `predev` / `predev:desktop` hooks in the root
# package.json to rebuild the agentlet workspace packages before starting
# the dev orchestrator — otherwise `external/agentlet/packages/*/dist/`
# can fall out of sync with `src/` (e.g. after switching branches), and
# `@sediment/server` loads stale `@agentlet/server` code, surfacing as
# `TypeError: server.init is not a function` at startup.
enable-pre-post-scripts=true
