# ── Sediment shared dev configuration ──
# Copy to `.env` (gitignored) and tweak as needed. All values are optional;
# defaults are used when unset.
#
# These values are read by both the server (apps/server) and the Vite dev
# server (apps/web) so the API proxy stays in sync with the backend port.
# For server-private secrets (LLM keys, etc.), use apps/server/.env instead.

# Backend HTTP port. Default: 3001
# SERVER_PORT=3001

# Vite dev server port. Default: 5173
# WEB_PORT=5173

# Optional: explicit proxy target override. If unset, derived from SERVER_PORT.
# VITE_API_PROXY_TARGET=http://localhost:3001

# ── HTTP Basic Auth (optional) ──
# When BOTH variables are set, the Vite dev server (5173) and the backend
# Fastify server (3001) require HTTP Basic Auth on every request.
# Browsers cache the credentials per-origin, so users only see the prompt once.
# WARNING: credentials travel as base64 in plaintext. Only safe on a trusted
# network or behind HTTPS. For public-IP exposure prefer Tailscale / reverse
# proxy with TLS.
# SEDIMENT_BASIC_AUTH_USER=team
# SEDIMENT_BASIC_AUTH_PASS=replace-with-a-long-random-string
